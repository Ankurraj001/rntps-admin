{
  "name": "rntps-admin",
  "private": true,
  "version": "0.1.0",
  "description": "School management system for RNTPS - students, fees and attendance",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @rntps/api",
    "dev:web": "npm run dev -w @rntps/web",
    "build": "npm run build -w @rntps/shared && npm run build -w @rntps/api && npm run build -w @rntps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test -w @rntps/api",
    "seed:settings": "npm run seed:settings -w @rntps/api",
    "mongo:start": "brew services start mongodb-community",
    "mongo:stop": "brew services stop mongodb-community",
    "indexes:sync": "npm run indexes:sync -w @rntps/api",
    "indexes:deploy": "if [ \"$CONTEXT\" = production ]; then npm run indexes:sync -w @rntps/api; else echo \"index sync skipped (CONTEXT=${CONTEXT:-local})\"; fi",
    "db:stats": "npm run db:stats -w @rntps/api",
    "seed:admin": "npm run seed:admin -w @rntps/api --",
    "reset:password": "npm run reset:password -w @rntps/api --",
    "test:e2e": "npm run test:e2e -w @rntps/web",
    "mail:test": "npm run mail:test -w @rntps/api --",
    "report:daily": "npm run report:daily -w @rntps/api --",
    "report:expenses": "npm run report:expenses -w @rntps/api --",
    "migrate:drop-plaintext": "npm run migrate:drop-plaintext -w @rntps/api --",
    "backfill:tuition": "npm run backfill:tuition -w @rntps/api --"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
