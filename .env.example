# ---- API (apps/api/.env) ----
NODE_ENV=development
PORT=4000

# MongoDB Atlas. Note the /rntps database name before the "?" — Atlas omits it from the
# string it gives you, and without it Mongoose writes to a database called "test".
# URL-encode the password if it contains @ : / ? # [ ] %
MONGODB_URI=mongodb+srv://USER:ENCODED_PASSWORD@your-cluster.abcde.mongodb.net/rntps?retryWrites=true&w=majority

# Local alternative:
# MONGODB_URI=mongodb://127.0.0.1:27017/rntps

# Comma-separated list of allowed browser origins. Only used in local dev — in
# production the SPA and API share one Netlify origin, so there is no cross-origin call.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# Access-token signing key. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-characters

# Optional, shown with their defaults
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=14
# MAX_FAILED_LOGINS=5
# ACCOUNT_LOCK_MINUTES=15
# PASSWORD_RESET_TTL_MINUTES=60
# INVITE_TTL_HOURS=72

# Public origin, used to build password-reset links. Must be what a browser can reach.
APP_BASE_URL=http://localhost:5173

# ---- Email ----
# With nothing set here, emails are logged to the console instead of sent, so local
# development works with no credentials. Account setup then falls back to a one-time
# password shown to the admin once.
#
# Resend is the transport in production. Create a key at https://resend.com/api-keys.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# MAIL_FROM defaults to "RNTPS Admin <onboarding@resend.dev>", which is enough to test with:
# Resend delivers from that address ONLY to the address your Resend account was registered
# with, and answers 403 for anyone else. Production must therefore set its own, on a domain
# verified at https://resend.com/domains — the app refuses to boot otherwise. Verify a
# sending subdomain (send.yourschool.in) rather than the root, so existing mail is untouched.
# MAIL_FROM="R.N. TPS Admin <noreply@yourschool.in>"

# Fallback transport, used when RESEND_API_KEY is unset. Works with any SMTP provider.
#
# Brevo is the one to reach for when you do NOT have a domain: 300/day free, and it verifies
# a single sender ADDRESS by emailing it a confirmation link, so there is no DNS to set up.
# SMTP_USER is NOT your account email — Brevo shows a separate login of the form
# xxxxxx@smtp-brevo.com under SMTP & API -> SMTP. SMTP_PASS is the SMTP key from the same
# page (xsmtpsib-...), not your password. MAIL_FROM must be the verified sender address.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=xxxxxx@smtp-brevo.com
# SMTP_PASS=your-brevo-smtp-key
# MAIL_FROM="R.N. TPS Admin <you@gmail.com>"   # must be the verified sender
#
# Or smtp.resend.com with username "resend" and the API key as the password.
#
# Gmail also works but is the weakest option: mail from a consumer account containing a link
# often lands in spam, and Google sometimes blocks sends from a data-centre IP such as a
# Netlify function. Enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords (your normal password will not work).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourschool@gmail.com
# SMTP_PASS=your-16-char-app-password

# ---- Web (apps/web/.env) ----
VITE_API_URL=http://localhost:4000/api/v1
