# ---- API (apps/api/.env) ----
NODE_ENV=development
PORT=4000

# MongoDB Atlas. Note the /rntps database name before the "?" — Atlas omits it from the
# string it gives you, and without it Mongoose writes to a database called "test".
# URL-encode the password if it contains @ : / ? # [ ] %
MONGODB_URI=mongodb+srv://USER:ENCODED_PASSWORD@your-cluster.abcde.mongodb.net/rntps?retryWrites=true&w=majority

# Local alternative:
# MONGODB_URI=mongodb://127.0.0.1:27017/rntps

# Comma-separated list of allowed browser origins. Only used in local dev — in
# production the SPA and API share one Netlify origin, so there is no cross-origin call.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=debug

# Access-token signing key. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-characters

# Optional, shown with their defaults
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=14
# MAX_FAILED_LOGINS=5
# ACCOUNT_LOCK_MINUTES=15
# PASSWORD_RESET_TTL_MINUTES=60

# Keeps a readable copy of each password alongside the hash, so an admin can look one up
# and tell a teacher what theirs is. Authentication always uses the hash; this field is
# only ever read.
#
# Off by default. Turning it on means a leak of the database — or of the connection
# string — hands over every staff password in usable form. Reads go through an audited,
# admin-only endpoint rather than the users list.
STORE_PLAINTEXT_PASSWORDS=false

# Public origin, used to build password-reset links. Must be what a browser can reach.
APP_BASE_URL=http://localhost:5173

# ---- Email (optional) ----
# Without these, password-reset emails are logged to the console instead of sent, so
# local development works with no credentials.
#
# Gmail: enable 2-Step Verification on the account, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (not your normal password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourschool@gmail.com
# SMTP_PASS=your-16-char-app-password
# MAIL_FROM="R.N. TPS Admin <yourschool@gmail.com>"

# ---- Web (apps/web/.env) ----
VITE_API_URL=http://localhost:4000/api/v1
